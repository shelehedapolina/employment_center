<%- include('_header', { title: 'Картка шукача', active: 'seekers' }) %>

<a href="/seekers" class="back-link">← Назад до списку</a>
<h1><%= s.last_name %> <%= s.first_name %> <%= s.middle_name || '' %></h1>

<div class="card">
  <h2>Особисті дані</h2>
  <div class="form-grid">
    <div><strong>Дата народження:</strong> <%= formatDate(s.birth_date) %></div>
    <div><strong>Стать:</strong> <%= s.gender === 'Ч' ? 'Чоловіча' : 'Жіноча' %></div>
    <div><strong>Паспорт:</strong> <%= s.passport_number %></div>
    <div><strong>ІПН:</strong> <%= s.tax_id || '—' %></div>
    <div><strong>Телефон:</strong> <%= s.phone %></div>
    <div><strong>Email:</strong> <%= s.email || '—' %></div>
    <div class="full"><strong>Адреса:</strong> <%= s.address %></div>
    <div><strong>Професія:</strong> <%= s.profession_name %></div>
    <div><strong>Бажана з/п:</strong> <%= formatMoney(s.desired_salary) %></div>
    <div><strong>Консультант:</strong> <%= s.consultant_name || '—' %></div>
    <div><strong>Статус:</strong> <span class="badge <%= seekerStatusClass(s.status) %>"><%= s.status %></span></div>
    <div><strong>Дата реєстрації:</strong> <%= formatDate(s.registration_date) %></div>
  </div>
  <div class="button-row">
    <a href="/match/<%= s.seeker_id %>" class="btn btn-primary">🎯 Підібрати вакансії</a>
    <form method="POST" action="/seekers/<%= s.seeker_id %>/delete" class="inline-form" onsubmit="return confirm('Видалити шукача?')">
      <button type="submit" class="btn btn-danger">Видалити</button>
    </form>
  </div>
</div>

<div class="card">
  <h2>Освіта (<%= education.length %>)</h2>
  <% if (education.length === 0) { %>
    <p class="muted">Немає записів про освіту</p>
  <% } else { %>
    <table>
      <thead><tr><th>Заклад</th><th>Ступінь</th><th>Спеціальність</th><th>Роки</th></tr></thead>
      <tbody>
        <% education.forEach(e => { %>
          <tr>
            <td><%= e.institution %></td>
            <td><span class="badge badge-info"><%= e.degree %></span></td>
            <td><%= e.specialty %></td>
            <td><%= e.start_year %>–<%= e.end_year || '...' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<div class="card">
  <h2>Досвід роботи (<%= experience.length %>)</h2>
  <% if (experience.length === 0) { %>
    <p class="muted">Немає записів про досвід</p>
  <% } else { %>
    <table>
      <thead><tr><th>Компанія</th><th>Посада</th><th>Період</th><th>Причина звільнення</th></tr></thead>
      <tbody>
        <% experience.forEach(w => { %>
          <tr>
            <td><strong><%= w.company_name %></strong></td>
            <td><%= w.position %></td>
            <td>
              <%= formatDate(w.start_date) %> –
              <%= formatDate(w.end_date, 'теперішній час') %>
            </td>
            <td class="muted"><%= w.reason_left || '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<div class="card">
  <h2>Заявки на вакансії (<%= applications.length %>)</h2>
  <% if (applications.length === 0) { %>
    <p class="muted">Шукач ще не подавав заявки</p>
  <% } else { %>
    <table>
      <thead><tr><th>Дата</th><th>Вакансія</th><th>Компанія</th><th>Статус</th><th>Співбесіда</th></tr></thead>
      <tbody>
        <% applications.forEach(a => { %>
          <tr>
            <td><%= formatDate(a.application_date) %></td>
            <td><%= a.title %></td>
            <td><%= a.company_name %></td>
            <td>
              <span class="badge <%= applicationStatusClass(a.status) %>"><%= a.status %></span>
            </td>
            <td><%= formatDate(a.interview_date) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<div class="card">
  <h2>Навчання (<%= enrollments.length %>)</h2>
  <% if (enrollments.length === 0) { %>
    <p class="muted">Шукач не зарахований на жодну програму</p>
  <% } else { %>
    <table>
      <thead><tr><th>Програма</th><th>Період</th><th>Годин</th><th>Статус</th><th>Оцінка</th></tr></thead>
      <tbody>
        <% enrollments.forEach(e => { %>
          <tr>
            <td><strong><%= e.name %></strong></td>
            <td><%= formatDate(e.start_date) %> – <%= formatDate(e.end_date) %></td>
            <td><%= e.duration_hours %></td>
            <td><span class="badge badge-info"><%= e.completion_status %></span></td>
            <td><%= e.final_grade ?? '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>

  <form method="POST" action="/trainings/enroll" class="toolbar">
    <input type="hidden" name="seeker_id" value="<%= s.seeker_id %>">
    <select name="training_id" required>
      <option value="" disabled selected>Оберіть програму…</option>
      <% trainings.forEach(t => { %>
        <% const full = t.enrolled >= t.max_students; %>
        <option value="<%= t.training_id %>" <%= full ? 'disabled' : '' %>>
          <%= t.name %> (<%= formatDate(t.start_date) %>, місць: <%= t.max_students - t.enrolled %>)<%= full ? ' — немає місць' : '' %>
        </option>
      <% }) %>
    </select>
    <button type="submit" class="btn btn-success">Зарахувати на навчання</button>
  </form>
</div>

<%- include('_footer') %>
