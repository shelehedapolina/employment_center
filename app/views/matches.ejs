<%- include('_header', { title: 'Підбір вакансій', active: 'seekers' }) %>

<a href="/seekers/<%= seeker.seeker_id %>" class="muted" style="text-decoration:none;">← До картки шукача</a>
<h1>🎯 Підбір вакансій для: <%= seeker.last_name %> <%= seeker.first_name %></h1>

<div class="card">
  <h2>Параметри пошуку</h2>
  <p><strong>Бажана зарплата:</strong> <%= seeker.desired_salary ? Number(seeker.desired_salary).toLocaleString('uk-UA') + ' ₴' : 'не вказано' %></p>
  <p class="muted">Алгоритм підбирає вакансії за професією та бажаною зарплатою. Score = 100 для повної відповідності за професією, 70 — якщо лише з/п підходить, 40 — близькі за з/п.</p>
</div>

<table>
  <thead>
    <tr>
      <th>Score</th>
      <th>Посада</th>
      <th>Компанія</th>
      <th>Професія</th>
      <th>Графік</th>
      <th>Зарплата</th>
    </tr>
  </thead>
  <tbody>
    <% if (matches.length === 0) { %>
      <tr><td colspan="6" class="empty-state">Підходящих вакансій не знайдено</td></tr>
    <% } %>
    <% matches.forEach(m => { %>
      <tr>
        <td>
          <% const cls = m.match_score >= 90 ? 'score-high' : m.match_score >= 60 ? 'score-mid' : 'score-low'; %>
          <span class="match-score <%= cls %>"><%= m.match_score %></span>
        </td>
        <td><strong><%= m.title %></strong></td>
        <td><%= m.company_name %><br><span class="muted"><%= m.industry %></span></td>
        <td class="muted"><%= m.profession_name %></td>
        <td><span class="badge badge-info"><%= m.work_schedule %></span></td>
        <td>
          <%= Number(m.salary_min).toLocaleString('uk-UA') %> –
          <strong><%= Number(m.salary_max).toLocaleString('uk-UA') %> ₴</strong>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('_footer') %>
