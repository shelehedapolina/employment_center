<%- include('_header', { title: 'Підбір вакансій', active: 'seekers' }) %>

<a href="/seekers/<%= seeker.seeker_id %>" class="back-link">← До картки шукача</a>
<h1>🎯 Підбір вакансій для: <%= seeker.last_name %> <%= seeker.first_name %></h1>

<div class="card">
  <h2>Параметри пошуку</h2>
  <p><strong>Бажана зарплата:</strong> <%= formatMoney(seeker.desired_salary, 'не вказано') %></p>
  <p class="muted">Алгоритм підбирає вакансії за професією та бажаною зарплатою. Score = 100 для повної відповідності за професією, 70 — якщо лише з/п підходить, 40 — близькі за з/п.</p>
</div>

<table>
  <thead>
    <tr>
      <th>Score</th>
      <th>Посада</th>
      <th>Компанія</th>
      <th>Професія</th>
      <th>Графік</th>
      <th>Зарплата</th>
    </tr>
  </thead>
  <tbody>
    <% if (matches.length === 0) { %>
      <tr><td colspan="6" class="empty-state">Підходящих вакансій не знайдено</td></tr>
    <% } %>
    <% matches.forEach(m => { %>
      <tr>
        <td>
          <span class="match-score <%= matchScoreClass(m.match_score) %>"><%= m.match_score %></span>
        </td>
        <td><strong><%= m.title %></strong></td>
        <td><%= m.company_name %><br><span class="muted"><%= m.industry %></span></td>
        <td class="muted"><%= m.profession_name %></td>
        <td><span class="badge badge-info"><%= m.work_schedule %></span></td>
        <td>
          <%= formatMoney(m.salary_min, '') %> –
          <strong><%= formatMoney(m.salary_max) %></strong>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('_footer') %>
