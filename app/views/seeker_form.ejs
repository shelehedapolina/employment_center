<%- include('_header', { title: 'Новий шукач', active: 'seekers' }) %>

<h1>Реєстрація нового шукача роботи</h1>

<div class="card">
  <form method="POST" action="/seekers">
    <div class="form-grid">
      <div class="form-group">
        <label>Прізвище *</label>
        <input type="text" name="last_name" required>
      </div>
      <div class="form-group">
        <label>Ім'я *</label>
        <input type="text" name="first_name" required>
      </div>
      <div class="form-group">
        <label>По батькові</label>
        <input type="text" name="middle_name">
      </div>
      <div class="form-group">
        <label>Дата народження *</label>
        <input type="date" name="birth_date" required>
      </div>
      <div class="form-group">
        <label>Стать *</label>
        <select name="gender" required>
          <option value="Ч">Чоловіча</option>
          <option value="Ж">Жіноча</option>
        </select>
      </div>
      <div class="form-group">
        <label>Серія і номер паспорту *</label>
        <input type="text" name="passport_number" required maxlength="15">
      </div>
      <div class="form-group">
        <label>ІПН</label>
        <input type="text" name="tax_id" maxlength="10" pattern="[0-9]{10}">
      </div>
      <div class="form-group">
        <label>Телефон *</label>
        <input type="tel" name="phone" required placeholder="+380...">
      </div>
      <div class="form-group">
        <label>Email</label>
        <input type="email" name="email">
      </div>
      <div class="form-group full">
        <label>Адреса *</label>
        <input type="text" name="address" required>
      </div>
      <div class="form-group">
        <label>Професія *</label>
        <select name="profession_id" required>
          <% professions.forEach(p => { %>
            <option value="<%= p.profession_id %>"><%= p.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>Консультант</label>
        <select name="consultant_id">
          <option value="">— не призначено —</option>
          <% consultants.forEach(c => { %>
            <option value="<%= c.consultant_id %>"><%= c.last_name %> <%= c.first_name %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>Бажана зарплата (₴)</label>
        <input type="number" name="desired_salary" min="0" step="100">
      </div>
      <div class="form-group">
        <label>Статус</label>
        <select name="status">
          <option value="Шукає">Шукає</option>
          <option value="Працевлаштований">Працевлаштований</option>
          <option value="На навчанні">На навчанні</option>
          <option value="Знятий з обліку">Знятий з обліку</option>
        </select>
      </div>
    </div>
    <div class="button-row">
      <button type="submit" class="btn btn-primary">Зберегти</button>
      <a href="/seekers" class="btn btn-secondary">Скасувати</a>
    </div>
  </form>
</div>

<%- include('_footer') %>
