<%- include('_header', { title: 'Заявки', active: 'applications' }) %>

<h1>Заявки на вакансії</h1>

<table>
  <thead>
    <tr>
      <th>№</th>
      <th>Дата</th>
      <th>Шукач</th>
      <th>Вакансія</th>
      <th>Компанія</th>
      <th>Статус</th>
      <th>Зміна статусу</th>
    </tr>
  </thead>
  <tbody>
    <% applications.forEach(a => { %>
      <tr>
        <td><%= a.application_id %></td>
        <td class="muted"><%= formatDate(a.application_date) %></td>
        <td><%= a.seeker_name %></td>
        <td><strong><%= a.vacancy_title %></strong></td>
        <td><%= a.company_name %></td>
        <td>
          <span class="badge <%= applicationStatusClass(a.status) %>"><%= a.status %></span>
        </td>
        <td>
          <form method="POST" action="/applications/<%= a.application_id %>/status" class="status-form">
            <select name="status">
              <% ['Подана','На розгляді','Відхилена','Запрошено на співбесіду','Прийнята'].forEach(s => { %>
                <option value="<%= s %>" <%= a.status===s ? 'selected' : '' %>><%= s %></option>
              <% }) %>
            </select>
            <button type="submit" class="btn btn-sm btn-primary">OK</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('_footer') %>
